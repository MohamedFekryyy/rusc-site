# Settings of the rūsc booking server. setup.sh copies this file to .env
# (which stays on the server: never commit it) and fills in every secret
# marked "generated". Fill in the lines marked "by hand".

# Address of the booking system; its DNS A record points at this server.
CAL_DOMAIN=booking.studio-rusc.com
# By hand: email for Let's Encrypt certificate notices.
ACME_EMAIL=
# Cal.diy image version, set from CAL_DIY_REF by setup.sh and update.sh.
CAL_IMAGE_TAG=

# Database. Password generated.
POSTGRES_USER=cal
POSTGRES_PASSWORD=
POSTGRES_DB=cal

# Cal.diy secrets, generated. Never change them once the server has started:
# CALENDSO_ENCRYPTION_KEY encrypts the credentials Cal.diy stores (Stripe…).
NEXTAUTH_SECRET=
CALENDSO_ENCRYPTION_KEY=
CRON_API_KEY=
CRON_SECRET=

# Booking emails, sent through Brevo (Brevo > SMTP & API > SMTP).
EMAIL_FROM=reservation@studio-rusc.com
EMAIL_FROM_NAME=rūsc
EMAIL_SERVER_HOST=smtp-relay.brevo.com
EMAIL_SERVER_PORT=587
# By hand: Brevo's SMTP login and SMTP key.
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

CALCOM_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LICENSE_CONSENT=agree
