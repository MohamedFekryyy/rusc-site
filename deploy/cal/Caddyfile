{
	email {$ACME_EMAIL}
}

{$CAL_DOMAIN} {
	encode zstd gzip

	# Public sign-up stays closed. The studio's admin account is created once
	# at /auth/setup, which Cal.diy only allows while no account exists.
	# (Cal.diy's build can't turn sign-up off: its Dockerfile doesn't pass
	# NEXT_PUBLIC_DISABLE_SIGNUP through.)
	@signup path /signup* /api/auth/signup*
	respond @signup 404

	reverse_proxy cal:3000
}
